<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotate Elements" Height="220" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Line 1: Axis Selection Dropdown (Default Y-Z Axis) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select Rotation Axis / Plane:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox Name="cb_Axis" Height="28" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Y-Z Axis (Rotate in Y-Z plane / around X-axis)" IsSelected="True"/>
                <ComboBoxItem Content="X-Z Axis (Rotate in X-Z plane / around Y-axis)"/>
                <ComboBoxItem Content="X-Y Axis (Rotate in X-Y plane / around Z-axis)"/>
            </ComboBox>
        </StackPanel>

        <!-- Line 2: Angle Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Rotation Angle (degrees):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Name="tb_Angle" Text="90" Height="28" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
        </StackPanel>

        <!-- Line 3: Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Name="btn_Run" Content="SELECT &amp; ROTATE" Grid.Column="0" Height="36" Margin="0,0,8,0"
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="OnRun"/>
            <Button Name="btn_Cancel" Content="CANCEL" Grid.Column="1" Width="80" Height="36"
                    Background="#D3D3D3" Foreground="#333333" FontWeight="Bold" BorderThickness="0" Click="OnCancel"/>
        </Grid>
    </Grid>
</Window>