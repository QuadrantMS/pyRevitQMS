<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Penetration Generator" Width="520" SizeToContent="Height"
        MaxHeight="850" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <!-- 1st Selection: Host Model -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="1. Select Structural/Host Model:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox Name="cb_LinkModel" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- 2nd Selection: Host Category (Locked per Button) & Type Filter Keyword -->
                <GroupBox Header="2. Intersecting Host Element &amp; Filter" Margin="0,0,0,10" Padding="8" FontWeight="SemiBold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Element Category:" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox Name="cb_Category" Height="26" VerticalContentAlignment="Center" FontWeight="Normal" IsEnabled="False">
                                <ComboBoxItem Content="Walls"/>
                                <ComboBoxItem Content="Floors"/>
                                <ComboBoxItem Content="Roofs"/>
                                <ComboBoxItem Content="Ceilings"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Type Name Filter (Blank = All):" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Name="tb_TypeFilterKeyword" Height="26" VerticalContentAlignment="Center" Padding="4,0,0,0" FontWeight="Normal"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- SECTION 3: RECTANGULAR DUCTS & ACCESSORIES -->
                <GroupBox Header="3. Rectangular Ducts &amp; Accessories Configuration" Margin="0,0,0,10" Padding="8" FontWeight="SemiBold">
                    <StackPanel>
                        <TextBlock Text="Select Family Symbol (Type to search):" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox Name="cb_SymbolRect" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6" FontWeight="Normal"
                                  IsEditable="True" IsTextSearchEnabled="False" KeyUp="OnRectComboKeyUp"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Offset Value (mm):" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Name="tb_OffsetRect" Text="50" Height="24" VerticalContentAlignment="Center" Padding="4,0,0,0" FontWeight="Normal"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Rotation Angle:" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox Name="cb_RotationRect" Height="24" VerticalContentAlignment="Center" FontWeight="Normal">
                                    <ComboBoxItem Content="0°"/>
                                    <ComboBoxItem Content="90° (Default)" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION 4: ROUND DUCTS & ACCESSORIES -->
                <GroupBox Header="4. Round Ducts &amp; Accessories Configuration" Margin="0,0,0,10" Padding="8" FontWeight="SemiBold">
                    <StackPanel>
                        <TextBlock Text="Select Family Symbol (Type to search):" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox Name="cb_SymbolRoundDuct" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6" FontWeight="Normal"
                                  IsEditable="True" IsTextSearchEnabled="False" KeyUp="OnRoundDuctComboKeyUp"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Offset Value (mm):" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Name="tb_OffsetRoundDuct" Text="50" Height="24" VerticalContentAlignment="Center" Padding="4,0,0,0" FontWeight="Normal"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Rotation Angle:" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox Name="cb_RotationRoundDuct" Height="24" VerticalContentAlignment="Center" FontWeight="Normal">
                                    <ComboBoxItem Content="0°"/>
                                    <ComboBoxItem Content="90° (Default)" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION 5: ROUND PIPES -->
                <GroupBox Header="5. Round Pipes Configuration" Margin="0,0,0,10" Padding="8" FontWeight="SemiBold">
                    <StackPanel>
                        <TextBlock Text="Select Family Symbol (Type to search):" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox Name="cb_SymbolPipe" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,6" FontWeight="Normal"
                                  IsEditable="True" IsTextSearchEnabled="False" KeyUp="OnPipeComboKeyUp"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Offset Value (mm):" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Name="tb_OffsetPipe" Text="25" Height="24" VerticalContentAlignment="Center" Padding="4,0,0,0" FontWeight="Normal"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Rotation Angle:" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox Name="cb_RotationPipe" Height="24" VerticalContentAlignment="Center" FontWeight="Normal">
                                    <ComboBoxItem Content="0°"/>
                                    <ComboBoxItem Content="90° (Default)" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Name="btn_PickElements" Content="PICK ELEMENTS" Grid.Column="0" Height="36" Margin="0,0,4,0"
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="OnPickElements"/>
            <Button Name="btn_EntireView" Content="ENTIRE ACTIVE VIEW" Grid.Column="1" Height="36" Margin="2,0,4,0"
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="OnEntireView"/>
            <Button Name="btn_Cancel" Content="CANCEL" Grid.Column="2" Width="85" Height="36"
                    Background="#D3D3D3" Foreground="#333333" FontWeight="Bold" BorderThickness="0" Click="OnCancel"/>
        </Grid>
    </Grid>
</Window>