<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLOOR PENETRATION GENERATOR" Width="660" SizeToContent="Height"
        MaxHeight="880" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA" FontFamily="Segoe UI" Foreground="#333333">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PROMINENT TOOL IDENTITY BANNER (UNIFIED TEMPLATE) -->
        <Border Grid.Row="0" Background="#EEF6FD" BorderBrush="#B8DAFF"
                BorderThickness="1.2" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="FLOOR PENETRATION GENERATOR" FontSize="16" FontWeight="Bold" Foreground="#0275D8" VerticalAlignment="Center"/>
        </Border>

        <!-- MAIN SCROLLABLE BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <!-- STEP 1: HOST MODEL & FILTER -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="1. Host Model:" FontSize="11.5" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                            <ComboBox Name="cb_LinkModel" Height="27" VerticalContentAlignment="Center" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Host Type Filter (Blank = All):" FontSize="11.5" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,4"/>
                            <TextBox Name="tb_TypeFilterKeyword" Height="27" VerticalContentAlignment="Center" Padding="5,0" Foreground="#333333"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 2: TARGET SCOPE -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. Elements to Process:" FontSize="11.5" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Name="chk_EnableMep" Content="Ducts &amp; Pipes" IsChecked="True" Margin="0,0,14,0" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        <CheckBox Name="chk_EnableGenericModel" Content="Generic Models" IsChecked="False" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        </StackPanel>
                    <Border Background="#F4F6F7" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bund Width (mm):" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,6,0"/>
                            <TextBox Name="tb_BundWidth" Text="100" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333" Margin="0,0,12,0"/>
                            <TextBlock Text="Bund Height (mm):" Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,6,0"/>
                            <TextBox Name="tb_BundThickness" Text="100" Grid.Column="3" Height="24" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333"/>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 3: SETTINGS -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Expander Name="exp_AdvancedSettings" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="3. Settings" FontSize="11.5" FontWeight="Bold" Foreground="#333333"/>
                        </Expander.Header>
                        <Grid Margin="2,8,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Element Type" Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="0,0,4,6"/>
                            <TextBlock Text="Penetration Family Types (Type to search)" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="0,0,6,6"/>
                            <TextBlock Text="Overall Offset (mm)" Grid.Row="0" Grid.Column="2" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="0,0,6,6"/>
                            <TextBlock Text="Rotation" Grid.Row="0" Grid.Column="3" FontWeight="Bold" FontSize="11" Foreground="#333333" Margin="0,0,0,6"/>
                            <TextBlock Text="Rect Ducts &amp; DA" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,4,5"/>
                            <ComboBox Name="cb_SymbolRect" Grid.Row="1" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,6,5" IsEditable="True" IsTextSearchEnabled="False"/>
                            <TextBox Name="tb_OffsetRect" Text="100" Grid.Row="1" Grid.Column="2" Height="25" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333" Margin="0,0,6,5"/>
                            <ComboBox Name="cb_RotationRect" Grid.Row="1" Grid.Column="3" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,0,5">
                                <ComboBoxItem Content="0° (Default)" IsSelected="True"/>
                                <ComboBoxItem Content="90°"/>
                            </ComboBox>
                            <TextBlock Text="Round Ducts &amp; DA" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,4,5"/>
                            <ComboBox Name="cb_SymbolRoundDuct" Grid.Row="2" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,6,5" IsEditable="True" IsTextSearchEnabled="False"/>
                            <TextBox Name="tb_OffsetRoundDuct" Text="100" Grid.Row="2" Grid.Column="2" Height="25" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333" Margin="0,0,6,5"/>
                            <ComboBox Name="cb_RotationRoundDuct" Grid.Row="2" Grid.Column="3" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,0,5">
                                <ComboBoxItem Content="0° (Default)" IsSelected="True"/>
                                <ComboBoxItem Content="90°"/>
                            </ComboBox>
                            <TextBlock Text="Round Pipes" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,4,5"/>
                            <ComboBox Name="cb_SymbolPipe" Grid.Row="3" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,6,5" IsEditable="True" IsTextSearchEnabled="False"/>
                            <TextBox Name="tb_OffsetPipe" Text="10" Grid.Row="3" Grid.Column="2" Height="25" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333" Margin="0,0,6,5"/>
                            <ComboBox Name="cb_RotationPipe" Grid.Row="3" Grid.Column="3" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,0,5">
                                <ComboBoxItem Content="0° (Default)" IsSelected="True"/>
                                <ComboBoxItem Content="90°"/>
                            </ComboBox>
                            <TextBlock Text="Generic Models" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,4,0"/>
                            <ComboBox Name="cb_SymbolGenericModel" Grid.Row="4" Grid.Column="1" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,6,0" IsEditable="True" IsTextSearchEnabled="False"/>
                            <TextBox Name="tb_OffsetGenericModel" Text="10" Grid.Row="4" Grid.Column="2" Height="25" VerticalContentAlignment="Center" Padding="4,0" Foreground="#333333" Margin="0,0,6,0"/>
                            <ComboBox Name="cb_RotationGenericModel" Grid.Row="4" Grid.Column="3" Height="25" VerticalContentAlignment="Center" Foreground="#333333" Margin="0,0,0,0">
                                <ComboBoxItem Content="0° (Default)" IsSelected="True"/>
                                <ComboBoxItem Content="90°"/>
                            </ComboBox>
                        </Grid>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <Button Name="btn_PickElements" Content="PICK ELEMENTS" Grid.Column="0" Height="36" Margin="0,0,4,0"
                    Background="#4FD97D" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="btn_EntireView" Content="ENTIRE ACTIVE VIEW" Grid.Column="1" Height="36" Margin="4,0,4,0"
                    Background="#0275D8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="btn_Cancel" Content="CANCEL" Grid.Column="2" Height="36" Margin="4,0,0,0"
                    Background="#E0E0E0" Foreground="#333333" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
