<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Continuous Duct Hanger Placement" Height="500" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="1. Select Accessory Category:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox Name="cb_Category" Height="28" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Duct Accessories" IsSelected="True"/>
                <ComboBoxItem Content="Pipe Accessories"/>
                <ComboBoxItem Content="Generic Models"/>
            </ComboBox>
        </StackPanel>

        <!-- Family Selection & Search -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="2. Select Hanger Family Symbol (Type to search):" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox Name="cb_FamilySymbol" Height="28" VerticalContentAlignment="Center" 
                      IsEditable="True" IsTextSearchEnabled="False"/>
        </StackPanel>

        <!-- Parameters Grid & Preview Image -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="3. Hanger Parameters (mm):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <!-- First Hanger Offset -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="First Hanger Offset:" VerticalAlignment="Center"/>
                        <TextBox Name="tb_FirstHangerOffset" Grid.Column="1" Height="24" Text="500" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hanger Spacing (A):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamA" Grid.Column="1" Height="24" Text="1500" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Duct U/S Clearance (B):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamB" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Duct Side Clearance (C):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamC" Grid.Column="1" Height="24" Text="100" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rod Offset From Left End (D):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamD" Grid.Column="1" Height="24" Text="50" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rod Offset From Right End (E):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamE" Grid.Column="1" Height="24" Text="50" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rod Bot Ext (F):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamF" Grid.Column="1" Height="24" Text="50" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rod Top Ext (G):" VerticalAlignment="Center"/>
                        <TextBox Name="tb_ParamG" Grid.Column="1" Height="24" Text="0" VerticalContentAlignment="Center" Padding="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Image Preview Section -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Background="White" Margin="0,20,0,0" Height="140" VerticalAlignment="Top">
                <Image Name="img_Preview" Stretch="Uniform" Margin="5"/>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Name="btn_PickElements" Content="PICK ELEMENTS" Grid.Column="0" Height="36" Margin="0,0,4,0"
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="btn_PickRun" Content="PICK RUN" Grid.Column="1" Height="36" Margin="2,0,4,0"
                    Background="#2e38cc" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="btn_Cancel" Content="CANCEL" Grid.Column="2" Width="85" Height="36"
                    Background="#D3D3D3" Foreground="#333333" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>