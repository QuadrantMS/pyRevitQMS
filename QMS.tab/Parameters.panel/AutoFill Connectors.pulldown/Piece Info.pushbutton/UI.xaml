<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autofill Piece Info" Height="280" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#f8f9fa">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Field 1: QMS_Duct_Additional_Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="QMS_Duct_Additional_Info:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#333333"/>
            <TextBox x:Name="txt_AdditionalInfo" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Field 2: QMS_Duct_Material -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="QMS_Duct_Material:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#333333"/>
            <TextBox x:Name="txt_Material" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Field 3: QMS_Duct_Specification -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="QMS_Duct_Specification:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#333333"/>
            <TextBox x:Name="txt_Specification" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_PickElements" Content="PICK ELEMENTS" Grid.Column="0" Height="34" Margin="0,0,3,0" 
                    Background="#4fd97d" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            
            <Button x:Name="btn_PickRun" Content="PICK RUN" Grid.Column="1" Height="34" Margin="3,0,3,0" 
                    Background="#4fd97d" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            
            <Button x:Name="btn_ActiveView" Content="ENTIRE ACTIVE VIEW" Grid.Column="2" Height="34" Margin="3,0,3,0" 
                    Background="#0275d8" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            
            <Button x:Name="btn_Cancel" Content="CANCEL" Grid.Column="3" Height="34" Margin="3,0,0,0" 
                    Background="#e0e0e0" Foreground="#333333" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>